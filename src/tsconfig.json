{
  "compilerOptions": {
    "module":           "Node16",
    "moduleResolution": "Node16",
    "target":           "ES2022",
    "outDir":           "./dist",
    "rootDir":          "./src",
    "strict":           true,
    "esModuleInterop":  true,
    "skipLibCheck":     true,
    "lib":              ["ES2022"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
